  "combos": [
    {
      "id": "exec_appointment",
      "family": "leadership_move",
      "weight": 4,
      "need": [
        "move_appoint",
        "exec_titles",
        "@person"
      ],
      "note": "appointment verb + executive title + a person name in one sentence",
      "not": [
        "funding_terms"
      ]
    },
    {
      "id": "board_appointment",
      "family": "board_move",
      "weight": 4,
      "need": [
        "move_appoint",
        "board_terms",
        "@person"
      ],
      "note": "appointment verb + board / advisory-board term + a person name",
      "not": [
        "funding_terms"
      ]
    },
    {
      "id": "pedigree_hire",
      "family": "pedigree_move",
      "weight": 4,
      "need": [
        "move_appoint",
        "@person",
        "pedigree_markers",
        "pedigree_orgs"
      ],
      "note": "appointment + person + 'formerly / previously / spent N years' + a named pedigree organisation (the strongest Layer 2 pattern)",
      "not": [
        "funding_terms"
      ]
    },
    {
      "id": "senior_departure",
      "family": "departure",
      "weight": 4,
      "need": [
        "move_depart",
        [
          "exec_titles",
          "tech_titles"
        ],
        "@person"
      ],
      "note": "departure verb + senior or technical title + a person name"
    },
    {
      "id": "departure_to_found",
      "family": "departure_to_found",
      "weight": 4,
      "need": [
        "move_depart",
        "found_launch"
      ],
      "note": "someone leaves to found / launch / start something (the Discovery Loop pattern)"
    },
    {
      "id": "founder_pedigree",
      "family": "departure_to_found",
      "weight": 3,
      "need": [
        "found_launch",
        "pedigree_orgs",
        "pedigree_markers"
      ],
      "note": "'founded by former X engineers' style founding-team pedigree",
      "not": [
        "funding_terms"
      ]
    },
    {
      "id": "technical_leader_hire",
      "family": "pedigree_move",
      "weight": 3,
      "need": [
        "move_appoint",
        "tech_titles",
        "pedigree_orgs"
      ],
      "note": "engineer / architect / scientist hire with a named pedigree organisation",
      "not": [
        "funding_terms"
      ]
    },
    {
      "id": "academic_move",
      "family": "academic_move",
      "weight": 3,
