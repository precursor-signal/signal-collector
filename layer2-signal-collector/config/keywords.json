    },
    {
      "id": "hiring_surge",
      "family": "hiring_surge",
      "weight": 3,
      "need": [
        "hiring_terms",
        "@hiring_scale"
      ],
      "note": "hiring wording + a count of engineers / roles / positions"
    },
    {
      "id": "headcount_growth",
      "family": "hiring_surge",
